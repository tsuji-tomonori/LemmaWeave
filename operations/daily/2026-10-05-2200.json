      "normalized_question_sha256": "90045d2d049c506b21b9acef19ef18746f9310278bc8699e520516368b8f6ae5",
      "source_question": "24 gallons per second of water flows down a waterfall. If you have an empty basin that can hold 260 gallons of water. The basin leaks water at 4 gallons per second. how long would it take to fill the basin with water from the waterfall in seconds?",
      "source_hashes_match_manifest": true
    }
